{
  "name": "classnote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@blocknote/core": "latest",
    "@blocknote/mantine": "latest",
    "@blocknote/math-block": "0.55.0",
    "@blocknote/react": "latest",
    "@handlewithcare/prosemirror-inputrules": "0.1.4",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@mantine/utils": "^6.0.22",
    "@noble/hashes": "^2.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "archiver": "^7.0.1",
    "fflate": "^0.8.3",
    "katex": "0.19.0",
    "lucide-react": "latest",
    "next": "16.4.3",
    "radix-ui": "latest",
    "react": "latest",
    "react-dom": "latest",
    "yauzl": "latest",
    "zod": "latest"
  },
  "overrides": {
    "@blocknote/math-block": {
      "katex": "$katex"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/archiver": "^6.0.3",
    "@types/katex": "latest",
    "@types/node": "^24",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/yauzl": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
