# Leave these unset for local use. Configure them on EdgeOne for the online project.
CLASSNOTE_STORAGE=cloud
CLASSNOTE_ORIGIN=https://lu.gucanyuexuchen.top
CLASSNOTE_OWNER_EMAIL=your-verified-email@example.com
SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key only; the application does not use a service_role key.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional private R2 attachments. Apply migration 002 before enabling.
# Leave CLASSNOTE_ATTACHMENT_STORAGE unset to keep new uploads in Supabase.
CLASSNOTE_ATTACHMENT_STORAGE=r2
R2_ACCOUNT_ID=your-32-character-cloudflare-account-id
R2_BUCKET=classnote-private
# Server-only credentials, scoped to this bucket's Object Read & Write permissions.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
